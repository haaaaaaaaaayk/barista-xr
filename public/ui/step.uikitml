<style>
  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAopxhTg.ttf");
    font-weight: 400;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwAkJxhTg.ttf");
    font-weight: 500;
  }

  @font-face {
    font-family: "DM Sans";
    src: url("https://fonts.gstatic.com/s/dmsans/v17/rP2tp2ywxg089UriI5-g4vlH9VoD8CmcqZG40F9JadbnoEwARZthTg.ttf");
    font-weight: 700;
  }

  
  .panel-root { flex-direction: column; font-family: "DM Sans"; width: 380px; }
  .content { flex-direction: column; padding-top: 18px; padding-left: 24px; padding-right: 24px; padding-bottom: 8px; }
  .eyebrow { font-size: 13px; font-weight: 700; letter-spacing: 1px; color: #b45309; }
  .title { font-size: 26px; font-weight: 700; line-height: 30px; color: #272727; margin-top: 6px; }
  .title:dark { color: rgba(255,255,255,0.95); }
  .body { font-size: 17px; font-weight: 500; line-height: 23px; color: #3f3f46; margin-top: 10px; width: 100%; }
  .body:dark { color: rgba(255,255,255,0.85); }
  .muted { font-size: 13px; font-weight: 400; line-height: 17px; color: #71717a; margin-top: 10px; width: 100%; }
  .muted:dark { color: rgba(255,255,255,0.6); }
  .progress { font-size: 18px; font-weight: 700; color: #b45309; margin-top: 12px; }
  .button { justify-content: flex-start; margin-left: 24px; margin-right: 24px; margin-top: 12px; margin-bottom: 22px; }
  .button-label { transform-translate-y: 1px; }
  .row { flex-direction: column; margin-top: 10px; width: 100%; }
  .row-title { font-size: 15px; font-weight: 700; line-height: 19px; color: #272727; width: 100%; }
  .row-title:dark { color: rgba(255,255,255,0.92); }
  .row-meta { font-size: 13px; font-weight: 400; line-height: 17px; color: #52525b; width: 100%; }
  .row-meta:dark { color: rgba(255,255,255,0.65); }
</style>
<Panel class="panel-root">
  <div class="content">
    <div id="step-label" class="eyebrow">STEP 1 OF 5</div>
    <div id="step-title" class="title">Place the cup</div>
    <div id="step-body" class="body">Grab the white cup and set it on the drip tray under the espresso machine.</div>
    <div id="step-progress" class="progress"> </div>
    <div id="step-hint" class="muted">Hands: pinch to grab. Controllers: hold the grip button.</div>
  </div>
  <Button id="restart-button" class="button">
    <ButtonIcon><RotateCcw></RotateCcw></ButtonIcon>
    <ButtonLabel class="button-label">Start over</ButtonLabel>
  </Button>
</Panel>
